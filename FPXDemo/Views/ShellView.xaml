<Window x:Class="FPXDemo.Views.ShellView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:oxy="http://oxyplot.org/wpf"
         xmlns:cal="http://www.caliburnproject.org"
        Title="Focus PX A-Scan Demo"
        Height="700" Width="1000"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="10">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="150"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,10" HorizontalAlignment="Left">
            <Button Content="Connect Device" Margin="5" Padding="10,5" cal:Message.Attach="ConnectDevice" />
            <Button Content="Create BeamSets" Margin="5" Padding="10,5" cal:Message.Attach="CreateBeamSets" />
            <Button Content="Setup Acquisition" Margin="5" Padding="10,5" cal:Message.Attach="SetupAcquisition" />
            <Button Content="Start A-Scan" Margin="5" Padding="10,5" cal:Message.Attach="StartAscanLoop" />
            <Button Content="Stop A-Scan" Margin="5" Padding="10,5" cal:Message.Attach="StopAscanLoop" />
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Serial Number:" FontWeight="Bold" VerticalAlignment="Center" />
            <TextBlock Text="{Binding SerialNumber}" Margin="10,0" VerticalAlignment="Center" />

            <TextBlock Text="IP Address:" FontWeight="Bold" Margin="20,0,0,0" VerticalAlignment="Center" />
            <TextBlock Text="{Binding IPAddress}" Margin="10,0" VerticalAlignment="Center" />

            <TextBlock Text="BeamSet:" FontWeight="Bold" Margin="20,0,0,0" VerticalAlignment="Center" />
            <TextBlock Text="{Binding BeamSetName}" Margin="10,0" VerticalAlignment="Center" />
        </StackPanel>

        <oxy:PlotView Model="{Binding PlotModel}" Grid.Row="2" />

        <TextBox Grid.Row="3"
                 Margin="0,10,0,0"
                 Text="{Binding Logging}"
                 VerticalScrollBarVisibility="Auto"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 IsReadOnly="True"
                 Background="Black"
                 Foreground="Lime"
                 FontFamily="Consolas"/>
    </Grid>
</Window>
